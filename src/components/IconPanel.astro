---
type IconName =
  | 'modalities'
  | 'screenreader'
  | 'compass'
  | 'building'
  | 'research'
  | 'lowvision'
  | 'inclusive'
  | 'quote'
  | 'route'
  | 'mic';

interface Props {
  icon: IconName;
  label: string;
}

const { icon, label } = Astro.props;
---

<div class="icon-panel">
  <div class="icon-panel__ring">
    {icon === 'modalities' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" aria-hidden="true">
        <rect x="9" y="20" width="4" height="10" />
        <rect x="17" y="13" width="4" height="24" />
        <rect x="25" y="17" width="4" height="16" />
        <rect x="33" y="9" width="4" height="32" />
      </svg>
    )}
    {icon === 'screenreader' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="14" y="8" width="16" height="32" rx="3" />
        <line x1="20" y1="34" x2="24" y2="34" />
        <path d="M35 18c2.5 2 2.5 10 0 12" />
        <path d="M39.5 14c4.5 3.5 4.5 16.5 0 20" />
      </svg>
    )}
    {icon === 'compass' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="24" cy="24" r="16" />
        <path d="M29 19l-3 10-10 3 3-10z" />
        <circle cx="24" cy="24" r="1.6" fill="currentColor" stroke="none" />
      </svg>
    )}
    {icon === 'building' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round" aria-hidden="true">
        <rect x="8" y="14" width="14" height="26" />
        <rect x="26" y="8" width="14" height="32" />
        <line x1="11" y1="20" x2="19" y2="20" />
        <line x1="11" y1="26" x2="19" y2="26" />
        <line x1="11" y1="32" x2="19" y2="32" />
        <line x1="29" y1="14" x2="37" y2="14" />
        <line x1="29" y1="20" x2="37" y2="20" />
        <line x1="29" y1="26" x2="37" y2="26" />
        <line x1="29" y1="32" x2="37" y2="32" />
      </svg>
    )}
    {icon === 'research' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="9" y="6" width="20" height="26" rx="1.5" />
        <line x1="14" y1="13" x2="24" y2="13" />
        <line x1="14" y1="18" x2="24" y2="18" />
        <line x1="14" y1="23" x2="20" y2="23" />
        <circle cx="30" cy="30" r="7" />
        <line x1="35" y1="35" x2="40" y2="40" />
      </svg>
    )}
    {icon === 'lowvision' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M5 24c4.5-8.5 12.5-14 19-14s14.5 5.5 19 14c-4.5 8.5-12.5 14-19 14S9.5 32.5 5 24z" />
        <circle cx="24" cy="24" r="6.5" />
      </svg>
    )}
    {icon === 'inclusive' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="24" cy="9" r="4" />
        <path d="M24 15v13" />
        <path d="M14 20h20" />
        <path d="M24 28l-8 11" />
        <path d="M24 28l8 11" />
      </svg>
    )}
    {icon === 'quote' && (
      <svg viewBox="0 0 48 48" fill="currentColor" stroke="none" aria-hidden="true">
        <path d="M9 27c0-7.5 4-13 10.5-15.5l1.8 4c-4 1.7-6.3 4.4-6.3 7.5h6v11H9z" />
        <path d="M26.5 27c0-7.5 4-13 10.5-15.5l1.8 4c-4 1.7-6.3 4.4-6.3 7.5h6v11h-12z" />
      </svg>
    )}
    {icon === 'route' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="10" cy="35" r="3" fill="currentColor" stroke="none" />
        <path d="M10 35c7-1 7-9 13-11s6-11 13-13" stroke-dasharray="1 5" />
        <path d="M30 5l8 2-5.5 6.5z" fill="currentColor" stroke="none" />
      </svg>
    )}
    {icon === 'mic' && (
      <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <rect x="18" y="7" width="12" height="21" rx="6" />
        <path d="M12 22a12 12 0 0 0 24 0" />
        <line x1="24" y1="34" x2="24" y2="40" />
        <line x1="16" y1="40" x2="32" y2="40" />
      </svg>
    )}
  </div>
  <p class="mono icon-panel__label">{label}</p>
</div>

<style>
  .icon-panel {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    text-align: center;
  }
  .icon-panel__ring {
    width: 108px;
    height: 108px;
    flex-shrink: 0;
    border-radius: 50%;
    border: 1px solid var(--color-line);
    display: flex;
    align-items: center;
    justify-content: center;
    color: var(--color-accent);
  }
  .icon-panel__ring svg {
    width: 46px;
    height: 46px;
  }
  .icon-panel__label {
    max-width: 18ch;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-graphite);
  }
</style>
